# AgriLink environment variables — copy to .env.local for local development.
#   PowerShell:  Copy-Item .env.example .env.local
# In Vercel, add the same names under Project → Settings → Environment Variables.
# NEVER commit .env.local or any file containing real keys.

# ── Public (sent to the browser; safe to expose) ───────────────────────────────
# Supabase → Project Settings → API. Leave both empty to run the read-only preview.
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_…). Older projects call it the "anon" key; either works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The site's public address, used in email links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" ONLY on the separate demo deployment (shows demo banners and demo sign-in).
# It never grants access by itself.
NEXT_PUBLIC_DEMO_MODE=false
# Shown on the Contact and About pages.
NEXT_PUBLIC_CONTACT_EMAIL=mahawar.manas@gmail.com

# ── Server only (never prefix these with NEXT_PUBLIC_) ─────────────────────────
# Supabase secret key (sb_secret_…, or the legacy service_role key). Bypasses Row Level
# Security. Used only by the payment webhook and the demo seed script. Optional until then.
SUPABASE_SECRET_KEY=

# Demo deployment only: the password for every seeded demo account (12+ characters).
# Leave EMPTY in production — demo sign-in is then switched off.
DEMO_ACCOUNT_PASSWORD=
# Optional overrides for the two demo sign-in accounts.
DEMO_FARMER_EMAIL=
DEMO_BUYER_EMAIL=

# ── Payments (NOT active — see docs/PAYMENTS_PLAN.md) ─────────────────────────
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
